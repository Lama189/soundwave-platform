RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=catalog-events
RABBITMQ_QUEUE=audio-worker-track-uploaded
RABBITMQ_ROUTING_KEY=track.uploaded

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false

MINIO_RAW_BUCKET=soundwave-raw
MINIO_AUDIO_BUCKET=soundwave-audio
MINIO_COVERS_BUCKET=soundwave-covers

TEMP_DIR=/tmp/soundwave-audio-worker
LOG_LEVEL=INFO
